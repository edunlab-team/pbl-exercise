{
  "project": "AMM02",
  "mission": "AMM02_M01",
  "title": "작전 단계별 탄약 및 유류 기준 소모율(CSR) 데이터 정의",
  "process_steps_5": [
    {
      "step": 1,
      "name": "일일 소모 보고 수집",
      "description": "각 대대 군수과로부터 24시간 실소모량 및 교전 현황 보고 수집"
    },
    {
      "step": 2,
      "name": "환산 소모량 산출",
      "description": "병력 100명당 환산 및 유류/탄종별 표준 단위 변환"
    },
    {
      "step": 3,
      "name": "보급 수준(DOS) 계산",
      "description": "현 비축량 대비 일일 예측 소모율 기반 잔여 지속일수 산정"
    },
    {
      "step": 4,
      "name": "재보급 결재 대기",
      "description": "긴급/주의 대상 부대에 대한 군수참모 HITL 승인 큐 등록"
    },
    {
      "step": 5,
      "name": "저장고 입고 및 배치",
      "description": "보급소/저장창 입고 및 안전 혼적 제약 기반 적재 위치 확정"
    }
  ],
