    {
      "case": "NEGATIVE_RANGE",
      "data": {
        "msg_id": "ERR_01",
        "sensor_id": "RADAR_01",
        "sensor_type": "RADAR",
        "range_km": -12.5,
        "azimuth_deg": 45.0,
        "timestamp": "2026-11-03T09:00:00Z"
      },
      "expected_error": "range_km must be >= 0"
    },
    {
      "case": "AZIMUTH_OVERFLOW",
      "data": {
        "msg_id": "ERR_02",
        "sensor_id": "RADAR_01",
        "sensor_type": "RADAR",
        "range_km": 30.0,
        "azimuth_deg": 385.0,
        "timestamp": "2026-11-03T09:00:00Z"
      },
      "expected_error": "azimuth_deg must be <= 360"
    },
    {
      "case": "UNKNOWN_SENSOR_TYPE",
      "data": {
        "msg_id": "ERR_03",
        "sensor_id": "SONAR_01",
        "sensor_type": "SONAR_SUB",
        "range_km": 20.0,
        "azimuth_deg": 90.0,
        "timestamp": "2026-11-03T09:00:00Z"
      },
      "expected_error": "unsupported sensor_type"
    },
    {
      "case": "MISSING_REQUIRED_MSG_ID",
      "data": {
        "sensor_id": "RADAR_01",
        "sensor_type": "RADAR",
        "range_km": 20.0,
        "azimuth_deg": 90.0,
        "timestamp": "2026-11-03T09:00:00Z"
      },
      "expected_error": "msg_id is required"
    },
    {
      "case": "INVALID_TIMESTAMP_FORMAT",
      "data": {
        "msg_id": "ERR_05",
        "sensor_id": "RADAR_01",
        "sensor_type": "RADAR",
        "range_km": 20.0,
        "azimuth_deg": 90.0,
        "timestamp": "2026/11/03 09:00"
      },
      "expected_error": "timestamp must match ISO-8601"
    },
    {
      "case": "CONFIDENCE_SCORE_OVERFLOW",
      "data": {
        "msg_id": "ERR_06",
        "sensor_id": "RADAR_01",
        "sensor_type": "RADAR",
        "range_km": 20.0,
        "azimuth_deg": 90.0,
        "timestamp": "2026-11-03T09:00:00Z",
        "confidence": 1.5
      },
      "expected_error": "confidence must be <= 1.0"
    }
  ]
